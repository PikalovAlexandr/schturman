# Окружение для локальной разработки

# База данных PostgreSQL
DATABASE_URL=postgresql://schturman:schturman_password@localhost:5432/schturman

# SurrealDB
SURREALDB_URL=http://localhost:8000
SURREALDB_USER=root
SURREALDB_PASS=root
SURREALDB_NS=schturman
SURREALDB_DB=schturman

# Qdrant
QDRANT_URL=http://localhost:6333

# MinIO S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=schturman-files
S3_REGION=us-east-1

# NATS
NATS_URL=nats://localhost:4222

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKey

# Redis
REDIS_URL=redis://localhost:6379

# JWT секреты
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Сервисы (порты)
AUTH_SERVICE_PORT=3001
PART_SERVICE_PORT=3002
DOCUMENT_SERVICE_PORT=3003
BOM_SERVICE_PORT=3004
CHANGE_SERVICE_PORT=3005
AI_ORCHESTRATOR_PORT=3006

# Логирование
RUST_LOG=info,schturman=debug
LOG_FORMAT=json

# OpenTelemetry
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317

# AI API ключи (опционально)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
